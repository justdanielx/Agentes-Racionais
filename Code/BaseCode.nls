globals [baseX baseY recursosEntregues extinçãoExploradores extinçãoColetores]

breed [Exploradores Explorador]
breed [Coletores Coletor]

patches-own [Tipo QtdRecurso]

turtles-own [Energia EnergiaMax Estado Velocidade Perceção recursoX recursoY conhecido? desvio]
Exploradores-own []
;Estado: Explorar/RegressarBase
Coletores-own [cargaAtual]
;Estado: Explorar/IrRecurso/Recolher/RegressarBase

to Setup
    clear-all

    set baseX 0
    set baseY 0
    set recursosEntregues 0
    set extinçãoExploradores -1
    set extinçãoColetores -1

    SetupPatches
    SetupTurtles
    reset-ticks
end

to Go
    ask turtles [
        if breed = Exploradores [moveExplorador]
        if breed = Coletores [moveColetor]
    ]

    checkDeath
    
    tick

    if extinçãoExploradores = -1 and count Exploradores = 0 [set extinçãoExploradores ticks]
    if extinçãoColetores = -1 and count Coletores = 0 [set extinçãoColetores ticks]

    if ticks >= maxTicks [stop]
    if count turtles = 0 [stop]
end