to SetupPatches
    ask patch 0 0 [
        set Tipo "Base"
        set pcolor gray - 1
    ]

    ask patches with [Tipo != "Base"] [
        let x random 100
        ifelse x < nObstáculos [
            set tipo "Obstáculo"
            set pcolor brown ;Montanhas/Rochas
        ]
        [
            set x random 100
            ifelse x < nRecursos [
                set tipo "Recurso" ;Ouro
                set QtdRecurso 15 + random 11 ;entre 15 e 25
                set pcolor yellow
            ] 
            [
                set tipo "Terreno Livre" ;Relva
                set pcolor green
            ]
        ]
    ]
end

to SetupTurtles
    create-Exploradores nExploradores [
        set Energia 125 + random 51 ;entre 125 e 175
        set Estado "Explorar"
        set Velocidade 2
        set Perceção 2.9 ;2 circulos à volta do agente + a própria patch
        set recursoEncontrado nobody
        set shape "person soldier"
        set color gray + 1
        set size 1.2
    ]

    create-Coletores nColetores [
        set Energia 125 + random 51
        set Estado "Procurar"
        set Velocidade 1
        set Perceção 1.5 ;1 círculo à volta do agente + a própria patch
        set cargaAtual 0
        set recurso nobody
        set shape "person construction"
        set color gray + 1
        set size 1
    ]
end