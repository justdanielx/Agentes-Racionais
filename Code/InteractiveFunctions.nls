to moveExplorador
    repeat Velocidade [

        verifyEnergy
        shareInfo

        let rx recursoX
        let ry recursoY

        let novos patches in-radius Perceção with [Tipo = "Recurso" and (pxcor != rx or pycor != ry)]

        if any? novos [
            let alvo min-one-of novos [distance myself]
            set recursoX [pxcor] of alvo
            set recursoY [pycor] of alvo
            set conhecido? true
        ]

        ifelse Estado = "Explorar"
            [explore]
            [if Estado = "RegressarBase" [goBackBase]]
    ]
end

to moveColetor
    repeat Velocidade [

        verifyEnergy

        let recursos patches in-radius Perceção with [Tipo = "Recurso"]
        if (any? recursos) and (Estado != "Recolher") and (Estado != "RegressarBase") [
            let alvo min-one-of recursos [distance myself]
            if (not conhecido?) or (distance alvo < distancexy recursoX recursoY) [
                set recursoX [pxcor] of alvo
                set recursoY [pycor] of alvo
                set conhecido? true
                set Estado "IrRecurso"
            ]
        ]

        ifelse Estado = "Explorar"
            [explore]
            [
                ifelse Estado = "IrRecurso"
                    [goRecurso]
                    [
                        ifelse Estado = "Recolher" 
                            [recolher]
                            [if Estado = "RegressarBase" [goBackBase]]
                    ]
            ]

    ]
end



to shareInfo
    if Comunicação? and conhecido? [
        let candidatos Coletores in-radius Perceção with [Estado = "Explorar"]
        if any? candidatos [
            let candidato min-one-of candidatos [distance myself]
            set conhecido? false
            ask candidato [
                set recursoX [recursoX] of myself
                set recursoY [recursoY] of myself
                set conhecido? true
                set Estado "IrRecurso"
            ]
        ]
    ]
end

to explore
    ifelse (can-move? 1) and ([tipo] of patch-ahead 1 != "Obstáculo" and [Tipo] of patch-ahead 1 != "Recurso") [
        ifelse [Tipo] of patch-ahead 1 = "Base" [
            forward 1
            ifelse Energia + (0.5 * (EnergiaMax)) >= EnergiaMax
                [set Energia EnergiaMax]
                [set Energia Energia + (0.5 * (EnergiaMax))] ;Energia atual + 50% da energia definida inicialmente
        ]
        [
            if [Tipo] of patch-ahead 1 = "Terreno Livre" [
                let x random 100
                if x < 90 [forward 1]
                if (x >= 90) and (x < 95) [rt 90]
                if (x >= 95) and (x < 100) [rt -90]
            ]
        ]
    ]
    [rt one-of [90 -90 180]] ;Direita, Esquerda, Para Trás

    set Energia (Energia - 1)
end

to goRecurso
    if Estado = "IrRecurso" [
        ifelse member? (patch recursoX recursoY) neighbors4
            [set Estado "Recolher"]
            [goTo recursoX recursoY]
    ]
end

to recolher
    ifelse (distancexy recursoX recursoY <= Perceção) and ([Tipo] of patch recursoX recursoY != "Recurso")
    [
        set conhecido? false
        ifelse cargaAtual > 0
            [set Estado "RegressarBase"]
            [set Estado "Explorar"]
    ] ;ve se a pacth que era recurso ja esgotou dentro do seu nivel de percecao, e dependendo de se tem carga volta a base ou explora
    [
        ask patch recursoX recursoY [
            set QtdRecurso (QtdRecurso - 1)
            if QtdRecurso = 0 [
                set Tipo "Terreno Livre"
                set pcolor green
            ]
        ]

        set cargaAtual (cargaAtual + 1)
        set Energia (Energia - 1)

        if [Tipo] of patch recursoX recursoY != "Recurso" [set conhecido? false]
        if cargaAtual >= cargaMáxima [set Estado "RegressarBase"]
    ]
end

to goBackBase
    goTo baseX baseY

    if [Tipo] of patch-here = "Base" [
        ifelse Energia + (0.5 * EnergiaMax) >= EnergiaMax
            [set Energia EnergiaMax]
            [set Energia Energia + (0.5 * EnergiaMax)]
        set desvio 0

        ifelse breed = Coletores
            [
                set recursosEntregues recursosEntregues + cargaAtual
                set cargaAtual 0
                ifelse conhecido?
                    [set Estado "IrRecurso"]
                    [set Estado "Explorar"]
            ]
            [if breed = Exploradores [set Estado "Explorar"]]
    ]
end